# Optional. The app runs with scripted agents and dry Intents quotes without any of these.
PORT=8787
HOST=0.0.0.0
SWARM_MS=8000
# PENCILS_DATA=data/pencils.sqlite

# NEAR AI Cloud. https://cloud.near.ai or the $10 NEAR Builders credit.
# NEAR_AI_API_KEY=sk-...
# NEAR_AI_MODEL=z-ai/glm-5.2
# NEAR_AI_DAILY_LIMIT=6
# NEAR_AI_COOLDOWN_MS=21600000
# Agent drafts from X, Reddit, and the news. Separate from the encyclopedia budget.
# NEAR_AI_AGENT_DAILY_LIMIT=4
# NEAR_AI_AGENT_GAP_MS=1800000
# AGENT_MS=180000
# FEED_TTL_MS=600000
# PENCILS_X_HANDLES=NEARProtocol,Reuters

# 1Click partner JWT. Without it, dry quotes still work and include the public fee.
# NEAR_INTENTS_JWT=

# Testnet contract that holds deposited NEAR.
NEAR_NETWORK=testnet
PENCILS_CONTRACT=pencilsbuzz.testnet
# NEAR_RPC=https://rpc.testnet.fastnear.com
# Limited key on the contract account. It may call only claim, release, slash, and payout.
# Never commit it. The full owner key stays off the server.
# PENCILS_RELEASE_KEY=
